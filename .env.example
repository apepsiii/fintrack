# Environment Configuration
# Copy this file to .env and update with your values

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost
GIN_MODE=release

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_HOURS=24

# Database Configuration
DB_PATH=./finance.db

# Security
BCRYPT_COST=10

# CORS (for production deployment)
ALLOWED_ORIGINS=http://localhost:8080,https://yourdomain.com

# Google Cloud Vision API (untuk OCR scan struk)
# Dapatkan credentials dari https://console.cloud.google.com
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# AI / LLM Settings
# Provider: openai | anthropic | groq | ollama
AI_PROVIDER=openai
# API Key dari provider yang dipilih
AI_API_KEY=your-api-key-here
# Model yang digunakan:
# OpenAI  : gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Anthropic: claude-3-haiku-20240307, claude-3-5-sonnet-20241022
# Groq    : llama-3.1-8b-instant, mixtral-8x7b-32768
# Ollama  : llama3.2, qwen2.5
AI_MODEL=gpt-4o-mini
# Base URL (ganti untuk Ollama/proxy):
# OpenAI : https://api.openai.com/v1
# Groq   : https://api.groq.com/openai/v1
# Ollama : http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7
