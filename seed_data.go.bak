package main

import (
	"database/sql"
	"fmt"
	"log"
	"time"

	_ "modernc.org/sqlite"
)

// Sample data seeder for testing and demonstration
func main() {
	db, err := sql.Open("sqlite", "./finance.db")
	if err != nil {
		log.Fatal("Failed to open database:", err)
	}
	defer db.Close()

	fmt.Println("🌱 Seeding sample transactions...")

	// Sample transactions for the current month
	transactions := []struct {
		Type       string
		Amount     int
		CategoryID int
		DaysAgo    int
	}{
		// Income
		{"income", 5000000, 4, 1},  // Gaji - 1 day ago
		{"income", 500000, 4, 15},  // Gaji - 15 days ago

		// Expenses - Makan
		{"expense", 45000, 1, 0},   // Makan - today
		{"expense", 75000, 1, 1},   // Makan - 1 day ago
		{"expense", 50000, 1, 2},   // Makan - 2 days ago
		{"expense", 85000, 1, 3},   // Makan - 3 days ago
		{"expense", 120000, 1, 4},  // Makan - 4 days ago
		{"expense", 95000, 1, 5},   // Makan - 5 days ago
		{"expense", 60000, 1, 7},   // Makan - 7 days ago
		{"expense", 150000, 1, 10}, // Makan - 10 days ago
		{"expense", 85000, 1, 12},  // Makan - 12 days ago
		{"expense", 70000, 1, 14},  // Makan - 14 days ago

		// Expenses - Transport
		{"expense", 50000, 2, 1},   // Transport - 1 day ago
		{"expense", 100000, 2, 3},  // Transport - 3 days ago
		{"expense", 75000, 2, 5},   // Transport - 5 days ago
		{"expense", 60000, 2, 8},   // Transport - 8 days ago
		{"expense", 80000, 2, 11},  // Transport - 11 days ago

		// Expenses - Tagihan
		{"expense", 200000, 3, 2},  // Tagihan - 2 days ago
		{"expense", 150000, 3, 9},  // Tagihan - 9 days ago
		{"expense", 300000, 3, 20}, // Tagihan - 20 days ago
	}

	successCount := 0
	for _, trx := range transactions {
		// Calculate date by subtracting days
		date := time.Now().AddDate(0, 0, -trx.DaysAgo)
		
		_, err := db.Exec(`
			INSERT INTO transactions (type, amount, category_id, date)
			VALUES (?, ?, ?, ?)
		`, trx.Type, trx.Amount, trx.CategoryID, date)

		if err != nil {
			log.Printf("❌ Failed to insert transaction: %v", err)
		} else {
			successCount++
		}
	}

	fmt.Printf("✅ Successfully seeded %d transactions!\n", successCount)
	fmt.Println("")
	fmt.Println("📊 Summary:")
	
	// Display summary statistics
	var totalIncome, totalExpense int
	db.QueryRow("SELECT COALESCE(SUM(amount), 0) FROM transactions WHERE type = 'income'").Scan(&totalIncome)
	db.QueryRow("SELECT COALESCE(SUM(amount), 0) FROM transactions WHERE type = 'expense'").Scan(&totalExpense)
	
	fmt.Printf("   💰 Total Income:   Rp %s\n", formatRupiah(totalIncome))
	fmt.Printf("   💸 Total Expense:  Rp %s\n", formatRupiah(totalExpense))
	fmt.Printf("   💵 Balance:        Rp %s\n", formatRupiah(totalIncome-totalExpense))
	fmt.Println("")
	
	// Display expense by category
	rows, _ := db.Query(`
		SELECT c.name, COALESCE(SUM(t.amount), 0) as total
		FROM categories c
		LEFT JOIN transactions t ON c.id = t.category_id AND t.type = 'expense'
		WHERE c.type = 'expense'
		GROUP BY c.id
		ORDER BY total DESC
	`)
	defer rows.Close()
	
	fmt.Println("📈 Expense by Category:")
	for rows.Next() {
		var categoryName string
		var amount int
		rows.Scan(&categoryName, &amount)
		if amount > 0 {
			fmt.Printf("   %s: Rp %s\n", categoryName, formatRupiah(amount))
		}
	}
	
	fmt.Println("")
	fmt.Println("🎉 Database seeding complete! Start the server to view the data.")
}

func formatRupiah(amount int) string {
	if amount < 0 {
		return fmt.Sprintf("-%s", formatRupiah(-amount))
	}
	
	str := fmt.Sprintf("%d", amount)
	n := len(str)
	
	if n <= 3 {
		return str
	}
	
	result := ""
	for i, digit := range str {
		if i > 0 && (n-i)%3 == 0 {
			result += "."
		}
		result += string(digit)
	}
	
	return result
}
